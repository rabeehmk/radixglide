# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.radixglide.com

# WhatsApp number in international format — enables every WhatsApp button and the floating chat button
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Contact form delivery (configure at least one) ----
# Generic webhook: Zapier, Make, n8n, Google Sheets (Apps Script), CRM, database endpoint…
CONTACT_WEBHOOK_URL=

# Email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
